@page "/mudblazordemo"

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">MudBlazor Demo</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowSnackbar">
        Click me!
    </MudButton>
    <MudSnackbarProvider />
</MudPaper>

@code {
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    void ShowSnackbar()
    {
        Snackbar.Add("MudBlazor is working!", Severity.Success);
    }
}
